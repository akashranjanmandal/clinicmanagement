{
  "name": "clinicmanagement",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "db:create-admin:prod": "NODE_ENV=production tsx src/lib/db/create-admin.ts",
    "db:setup:local": "drizzle-kit migrate && tsx src/lib/db/seed.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:create-admin": "tsx src/lib/db/create-admin.ts",
    "test": "node --import tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@libsql/client": "^0.18.0",
    "@next/env": "^16.4.6",
    "bcryptjs": "^3.0.3",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
