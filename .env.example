# Template of every variable the app reads. Never put real secrets here.
#
# File layout (standard Next.js, all real files are gitignored):
#   .env.development.local  -> `npm run dev`            (local SQLite + dummy data)
#   .env.production.local   -> `npm run build/start`    (real Turso; local prod testing)
#   Hosting provider (Vercel etc.) -> set the same variables in its dashboard for deploys.

# Database: `file:local.db` for dev, `libsql://<db>.turso.io` + token for prod.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Signs admin sessions + rate-limit keys. Min 32 chars. Generate: openssl rand -base64 48
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPS_EMBED_URL=

# DEV ONLY: fictional demo data + seeded admin (refused when NODE_ENV=production).
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# One-time admin bootstrap (`npm run db:create-admin[:prod]`), password >= 12 chars.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
