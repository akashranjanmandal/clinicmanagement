# Every variable the app reads. One env, real Turso database.
# Local: copy to .env.local. Netlify: add the same names in Site configuration -> Environment variables.

TURSO_DATABASE_URL=libsql://YOUR-DB.turso.io
TURSO_AUTH_TOKEN=

# Signs admin sessions + rate-limit keys. Min 32 chars. Generate: openssl rand -base64 48
AUTH_SECRET=

# Your live site URL (set before building; it is baked into the build).
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
NEXT_PUBLIC_MAPS_EMBED_URL=

# Only for the one-time `npm run db:create-admin` command (password >= 12 chars). Not needed on Netlify.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
